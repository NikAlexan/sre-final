# Copy to secrets.yaml, fill values, apply manually:
#   kubectl apply -f k8s/secrets.yaml
# secrets.yaml is git-ignored.
apiVersion: v1
kind: Secret
metadata:
  name: fooddelivery-secret
  namespace: fooddelivery
type: Opaque
stringData:
  JWT_SECRET: "change-me-in-production"
  DATABASE_URL_USER: "postgres://postgres:postgres@postgres-user:5432/userdb?sslmode=disable"
  DATABASE_URL_RESTAURANT: "postgres://postgres:postgres@postgres-restaurant:5432/restaurantdb?sslmode=disable"
  DATABASE_URL_ORDER: "postgres://postgres:postgres@postgres-order:5432/orderdb?sslmode=disable"
  DATABASE_URL_DELIVERY: "postgres://postgres:postgres@postgres-delivery:5432/deliverydb?sslmode=disable"
  POSTGRES_PASSWORD: "postgres"
