# Copy to secrets.yaml, fill values, then:
#   kubectl apply -f k8s/secrets.yaml
# secrets.yaml is git-ignored — never commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: prestashop-secret
  namespace: ecommerce
type: Opaque
stringData:
  db-password: "changeme"
  prestashop-password: "changeme"
